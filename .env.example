# ==============================================================================
# OnBrand — Environment Variable Configuration Matrix
# Reference: PROJECT.md § 5.5 Environment Variable Configuration Matrix
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL transaction connection pooler (port 6543) - REQUIRED (Secret)
# Format: postgres://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/[db]?pgbouncer=true
DATABASE_URL=

# Direct PostgreSQL connection for DDL migrations (port 5432) - REQUIRED for schema setup (Secret)
# Format: postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Storage API
# ------------------------------------------------------------------------------
# Public HTTPS endpoint for Supabase project - REQUIRED (Public)
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous / publishable API key for client-side authentication - REQUIRED (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serverless Admin service role key for tenant provisioning and server-side auth verification - REQUIRED (Secret)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Model Verification Gateway (Hosted LLM / Semantic Verifier C5)
# ------------------------------------------------------------------------------
# Hosted LLM API key for two-pass C5 semantic verifier - REQUIRED for model-assisted mode (Secret)
# When omitted or ENABLE_HOSTED_MODEL=false, reviews run in transparent deterministic mode.
OPENAI_API_KEY=

# Target model identifier (default: gpt-4o-mini) - OPTIONAL
OPENAI_MODEL=gpt-4o-mini

# Optional custom endpoint or reverse proxy URL (e.g. for local testing or custom gateway)
OPENAI_BASE_URL=

# Explicit gate to activate external model calls - Set to 'true' only when OPENAI_API_KEY is provided
ENABLE_HOSTED_MODEL=false

# ------------------------------------------------------------------------------
# 4. Application Runtime & Deployment
# ------------------------------------------------------------------------------
# Base URL of deployed application - REQUIRED (Public)
# Default production domain: https://outcoded.xyz | Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://outcoded.xyz

# Node.js environment flag: 'development' | 'production' | 'test'
NODE_ENV=development
